# Copy to .env before running the app: cp .env.example .env
DATABASE_URL="postgresql://internal:internal@localhost:5433/internal_tools?schema=public"

# Auth.js. Any non-empty string works for local demo use.
AUTH_SECRET="dev-only-secret-change-me"
AUTH_TRUST_HOST="true"

# Integrations: "mock" (default) logs calls and writes audit rows without leaving the machine.
# "live" selects the real clients, which are stubs in this PoC.
INTEGRATIONS_MODE="mock"

# Microsoft Entra ID SSO. Leave unset for the demo; the provider is only registered
# when both values are present.
# AUTH_MICROSOFT_ENTRA_ID_ID=""
# AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=""
